# ============================================
# CINEVO v2 ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Copy this to .env.local and fill in values
# NEVER commit .env files to git
# ============================================

# ─── AUTH (Clerk / Better Auth) ─────────────
# Enable user authentication & accounts
VITE_AUTH_ENABLED=true

# Clerk public key (safe to expose to browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_key_here

# Clerk secret key (server-only, NEVER expose)
CLERK_SECRET_KEY=sk_live_your_key_here

# Better Auth secret (used for JWT/session signing)
AUTH_SECRET=your_secure_random_secret_here_min_32_chars

# ─── DATABASE ───────────────────────────────
# PostgreSQL connection string (Vercel injects this on deploy)
# Local dev uses PGLite (in-process), so this is optional in dev
DATABASE_URL=postgresql://user:password@localhost:5432/cinevo_dev

# ─── EXTERNAL SERVICES ──────────────────────
# Plex server URL (for library bridging)
PLEX_SERVER_URL=http://192.168.1.100:32400

# Plex API token (get from Plex web UI settings)
PLEX_API_TOKEN=your_plex_token_here

# Jellyfin server URL (alternative to Plex)
JELLYFIN_SERVER_URL=http://192.168.1.100:8096

# Jellyfin API token (get from Jellyfin web UI)
JELLYFIN_API_TOKEN=your_jellyfin_token_here

# ─── OPTIONAL: AI FEATURES ──────────────────
# xAI API key (for Grok integration, if enabled)
XAI_API_KEY=xai-your-key-here

# ─── DEPLOYMENT ─────────────────────────────
# Node environment (development | production)
NODE_ENV=development

# Vercel deployment URL (set automatically on Vercel)
VERCEL_URL=http://localhost:8080
