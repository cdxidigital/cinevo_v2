#!/bin/sh
# Pre-commit hook: run quality gates before commit
# Install: cp .githooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

echo "[pre-commit] Running quality gates..."

echo "[1/3] Running Prettier..."
npm run format > /dev/null 2>&1 || {
  echo "❌ Prettier failed. Run 'npm run format' and commit again."
  exit 1
}

echo "[2/3] Running ESLint..."
npm run lint > /dev/null 2>&1 || {
  echo "❌ ESLint failed. Fix violations and commit again."
  exit 1
}

echo "[3/3] Running TypeScript check..."
npm run typecheck > /dev/null 2>&1 || {
  echo "❌ TypeScript check failed. Fix type errors and commit again."
  exit 1
}

echo "✅ All checks passed. Committing..."
exit 0
